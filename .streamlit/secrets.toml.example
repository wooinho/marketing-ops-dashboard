# 이 파일은 예시입니다. 실제 값을 채운 secrets.toml 은 절대 git에 커밋하지 마세요
# (.gitignore에 이미 제외되어 있습니다).
#
# 로컬에서 테스트하려면 이 파일을 .streamlit/secrets.toml 로 복사한 뒤 값을 채우세요.
# 배포본(Streamlit Community Cloud)에서는 Manage app → Settings → Secrets 에
# 아래와 동일한 형식으로 붙여넣으면 됩니다.

ANTHROPIC_API_KEY = "sk-ant-..."
NOTION_TOKEN = "ntn_..."
SLACK_BOT_TOKEN = "xoxb-..."
