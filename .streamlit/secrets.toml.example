# 이 파일은 예시입니다. 실제 값을 채운 secrets.toml 은 절대 git에 커밋하지 마세요
# (.gitignore에 이미 제외되어 있습니다).
#
# 로컬에서 테스트하려면 이 파일을 .streamlit/secrets.toml 로 복사한 뒤 값을 채우세요.
# 배포본(Streamlit Community Cloud)에서는 Manage app → Settings → Secrets 에
# 아래와 동일한 형식으로 붙여넣으면 됩니다.

ANTHROPIC_API_KEY = "sk-ant-..."
NOTION_TOKEN = "ntn_..."
SLACK_BOT_TOKEN = "xoxb-..."

# 구글 서비스 계정 JSON 키 파일의 내용을 그대로 TOML 테이블로 옮겨 붙여넣으세요.
# (JSON의 큰따옴표 키를 = 형식으로 바꾸고, private_key의 개행은 그대로 "\n"으로 둡니다.)
[google_service_account]
type = "service_account"
project_id = "..."
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "...@....iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
